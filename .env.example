# Supabase — findest du in deinem Supabase-Projekt unter Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Project Settings > API > service_role (geheim! nur serverseitig, nie im Browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google AI Studio (Gemini) — dein API-Key von aistudio.google.com (NUR server-seitig verwendet)
GEMINI_API_KEY=AIza...

# Optional: E-Mail-Benachrichtigungen (z.B. "wartet auf Freigabe", "Prüfung bestanden").
# Ohne gesetzten RESEND_API_KEY wird der E-Mail-Versand übersprungen, die App
# funktioniert auch ohne ihn normal weiter. API-Key von resend.com.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=HB Sales Academy <benachrichtigungen@deine-domain.de>
# Für Links in E-Mails (z.B. "Zur Freigabe") — die öffentliche URL der App.
NEXT_PUBLIC_APP_URL=https://deine-domain.de
